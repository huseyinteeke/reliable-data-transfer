{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Sender",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/sender",
      "args": [
        "--emulator",
        "127.0.0.1:5000",
        "--file",
        "${workspaceFolder}/testdata/input.bin",
        "--proto",
        "sr",
        "--window",
        "16",
        "--k",
        "7",
        "--payload",
        "1024",
        "--log",
        "${workspaceFolder}/logs/sender.log"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Pass SIGPIPE/SIGALRM through",
          "text": "handle SIGPIPE SIGALRM nostop noprint pass",
          "ignoreFailures": true
        }
      ],
      "presentation": {
        "group": "1. Single",
        "order": 0,
        "hidden": false
      },
      "preLaunchTask": "Prepare Debug: Sender"
    },
    {
      "name": "Debug: Receiver",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/bin/receiver",
